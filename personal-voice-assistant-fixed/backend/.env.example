# Copy to .env and fill only the values you actually use. Never commit .env.
APP_NAME=Personal Voice Assistant
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-random-local-secret
DATABASE_URL=sqlite:///./data/assistant.db

# Use ONLY your two self-hosted OpenAI-compatible model endpoints; no paid API keys.
# Paste the full /v1/chat/completions URLs exactly as provided by your GPU server.
DEFAULT_MODEL_PROVIDER=qwen
QWEN_MODEL_URL=
QWEN_MODEL_NAME=
QWEN_API_FORMAT=openai
OLLAMA_URL=
OLLAMA_MODEL=
GPT_OSS_API_FORMAT=openai
AGENT_MODEL_ROUTING_ENABLED=true
MODEL_REQUEST_TIMEOUT=120
MODEL_MAX_RETRIES=2
AVA_API_BASE_URL=http://127.0.0.1:8000
MCP_TOOL_TIMEOUT=90
MCP_HTTP_FALLBACK=true

STT_MODEL_SIZE=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
PYANNOTE_AUTH_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
TTS_ENGINE=browser
TTS_VOICE=
WAKE_WORD_ENABLED=false
WAKE_WORD_MODEL=
AUDIO_SAMPLE_RATE=16000

DEFAULT_WEB_SEARCH_PROVIDER=duckduckgo
SEARXNG_BASE_URL=
BROWSER_HEADLESS=true
PLAYWRIGHT_ENABLED=true
BROWSER_ALLOWED_DOMAINS=
WEB_REQUEST_TIMEOUT=20
WORKSPACE_ROOTS=../workspace
ALLOWED_COMMANDS=git,pytest,ruff,python
ALLOWED_DESKTOP_APPS=firefox,chromium,code,xdg-open,gnome-calculator,kcalc,galculator,xcalc

EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_OAUTH_CLIENT_ID=
EMAIL_OAUTH_CLIENT_SECRET=
EMAIL_OAUTH_REDIRECT_URI=

MEETING_RECORDING_ENABLED=false
MEETING_AUDIO_SOURCE=microphone
MEETING_RETENTION_DAYS=30

DATA_DIR=./data
RECORDINGS_DIR=./data/recordings
DOCUMENTS_DIR=./data/documents
GENERATED_FILES_DIR=./data/generated

REQUIRE_EMAIL_APPROVAL=true
REQUIRE_FILE_DELETE_APPROVAL=true
REQUIRE_COMMAND_APPROVAL=true
ALLOW_EXTERNAL_UPLOADS=false
AUDIT_LOG_ENABLED=true
